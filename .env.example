TT_WORKER_IMAGE=ghcr.io/nobody13314/tt-worker:latest
TASK_PLATFORM_URL=http://host.docker.internal:8081
TASK_UID=worker_001_tt
TASK_GET_PATH=/api/worker/get-task
TASK_COMPLETE_PATH=/api/worker/complete-batch
TASK_TYPE_ID=38

DEVICE_API_URL=http://host.docker.internal:8000
DEVICE_API_KEY=replace-device-key
DEVICE_POOL_ID=
DEVICE_POOL_GROUP_ID=
DEVICE_BATCH_SIZE=100
DEVICE_ALLOW_PARTIAL=false
DEVICE_ORDER=oldest

SIGNER_URL=http://host.docker.internal:8001/api/sign

PROXY_GATEWAY_URL=http://host.docker.internal:8080
GATEWAY_API_KEY=replace-gateway-key
PROXY_GATEWAY_BUSINESS=tt_dz
PROXY_GATEWAY_WORKER_ID=machine-01-tt-dz
PROXY_GATEWAY_ALLOCATE_CONTENT_TYPE=application/json

GROUP_SIZE=30
PROXY_FAILURE_RATIO=0.8
MAX_PROXY_ROTATIONS=2
CONCURRENCY=30
LOG_DETAIL=all
POLL_INTERVAL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=30
